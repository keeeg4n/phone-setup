#!/bin/bash
# Show the phone's call history; double-click an entry to call back from the laptop.
# Usage: phone-call-log [--phone NAME]
source "$HOME/.local/lib/phone-continuity/common.sh"
pc_phone_opt "$@"; shift $PC_SHIFT
pc_select "$PHONE_ARG" || exit 1

PICK=$(
  pc_adb_shell "content query --uri content://call_log/calls --projection name:number:type:date:duration --sort 'date DESC'" 2>/dev/null |
    tr -d '\r' | python3 -c '
import re, sys, datetime
kinds = {"1": "↙ Incoming", "2": "↗ Outgoing", "3": "✗ Missed", "5": "✗ Declined", "6": "⊘ Blocked"}
for line in sys.stdin:
    m = re.search(r"name=(.*?), number=(.*?), type=(\d+), date=(\d+), duration=(\d+)", line)
    if not m: continue
    name, num, kind, date, dur = m.groups()
    when = datetime.datetime.fromtimestamp(int(date) / 1000).strftime("%d %b, %H:%M")
    d = int(dur)
    for v in (name if name != "NULL" else num, num, kinds.get(kind, kind), when,
              f"{d // 60}:{d % 60:02d}" if d else ""):
        print(v)' |
    zenity --list --title="$NAME — call history" --text="Double-click to call back." \
      --column=Name --column=Number --column=Type --column=When --column=Length \
      --print-column=2 --width=640 --height=560 2>/dev/null
) || exit 0
[ -n "$PICK" ] && exec "$HOME/.local/bin/phone-dial" --phone "$NAME" "$PICK"
