#!/bin/bash
# Keep each set-up phone's storage mounted (via GSConnect / KDE Connect) whenever the
# phone is reachable, so its Files sidebar bookmark always works. Runs as a user service.
source "$HOME/.local/lib/phone-continuity/common.sh"

while true; do
  while read -r c; do
    [ -n "$c" ] || continue
    pc_load "$c"
    [ -n "$KDEC_ID" ] || continue
    pc_link_reachable "$KDEC_ID" || continue
    if pc_link_mounted "$KDEC_ID"; then
      # The link can keep saying "mounted" after the phone's sftp server goes away,
      # leaving a dead mount that gives I/O errors and hangs Files. Remount it then.
      timeout 5 stat "$(pc_link_storage "$KDEC_ID")" >/dev/null 2>&1 && continue
      pc_link_unmount "$KDEC_ID"
      sleep 2
    fi
    pc_link_mount "$KDEC_ID"
  done <<< "$(pc_confs)"
  sleep 20
done
