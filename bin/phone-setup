#!/bin/bash
# Set up (or repair) a phone for all the phone-* tools. Plug the phone in by USB first.
# Safe to re-run: steps that are already done are skipped. Re-run it after the phone
# restarts to turn Wi-Fi debugging back on.
source "$HOME/.local/lib/phone-continuity/common.sh"
mkdir -p "$PC_DIR"

bold() { printf '\n\033[1m%s\033[0m\n' "$*"; }
ok()   { printf '  \033[32m✓\033[0m %s\n' "$*"; }
warn() { printf '  \033[33m!\033[0m %s\n' "$*"; }
ask()  { local a; read -rp "  $1 [Y/n] " a; [[ ! "$a" =~ ^[Nn] ]]; }
# wait_for <seconds> <message> <command...>: poll until the command succeeds
wait_for() {
  local secs=$1 msg=$2; shift 2
  printf '  … %s ' "$msg"
  for ((i=0; i<secs; i+=2)); do
    if "$@" >/dev/null 2>&1; then echo; return 0; fi
    printf '.'; sleep 2
  done
  echo; return 1
}

# ── 1. Find the phone on USB ────────────────────────────────────────────────
bold "1. Phone on USB"
usb_serials() { "$ADB" devices | awk 'NR>1 && $1 !~ /:/ && $2=="device"{print $1}'; }
usb_unauth()  { "$ADB" devices | awk 'NR>1 && $1 !~ /:/ && $2=="unauthorized"{f=1} END{exit !f}'; }
have_usb()    { [ -n "$(usb_serials)" ]; }

if [ -z "$(usb_serials)" ]; then
  if usb_unauth; then
    warn "Unlock the phone and tap Allow on \"Allow USB debugging?\" (tick \"Always allow\")."
  else
    warn "No phone found. On the phone: Settings → About phone → tap Build number 7 times,"
    warn "then Settings → System → Developer options → turn on USB debugging. Then plug it in."
  fi
  wait_for 300 "waiting for the phone" have_usb \
    || { echo "  Gave up waiting. Run phone-setup again when the phone is plugged in."; exit 1; }
fi

mapfile -t SERIALS < <(usb_serials)
SERIAL=${SERIALS[0]}
if [ ${#SERIALS[@]} -gt 1 ]; then
  echo "  Several phones are plugged in:"
  select s in "${SERIALS[@]}"; do [ -n "$s" ] && { SERIAL=$s; break; }; done
fi
ADB_ID=$SERIAL

CONF="$PC_DIR/$SERIAL.conf"
if [ -f "$CONF" ]; then pc_load "$CONF"; ok "Known phone: $NAME (re-checking its setup)"; fi

DETECTED_NAME=$(pc_adb_shell settings get global device_name | tr -d '\r')
[ -z "$DETECTED_NAME" ] || [ "$DETECTED_NAME" = "null" ] && DETECTED_NAME=$(pc_adb_shell getprop ro.product.model | tr -d '\r')
NAME=${NAME:-$DETECTED_NAME}
BT_MAC=$(pc_adb_shell settings get secure bluetooth_address | tr -d '\r')
[ "$BT_MAC" = "null" ] && BT_MAC=""
DEVICE_TYPE=phone
pc_adb_shell getprop ro.build.characteristics | grep -q tablet && DEVICE_TYPE=tablet
ok "$NAME ($DEVICE_TYPE, serial $SERIAL, Android $(pc_adb_shell getprop ro.build.version.release | tr -d '\r'))"

save_conf() {
  cat > "$CONF" <<EOF
NAME="$NAME"
SERIAL="$SERIAL"
WIFI_IP="$WIFI_IP"
BT_MAC="$BT_MAC"
KDEC_ID="$KDEC_ID"
DEVICE_TYPE="$DEVICE_TYPE"
EOF
}

# ── 2. Wi-Fi debugging ──────────────────────────────────────────────────────
bold "2. Wireless connection"
WIFI_IP=$(pc_adb_shell ip -f inet addr show wlan0 2>/dev/null | grep -oE 'inet [0-9.]+' | cut -d' ' -f2)
if [ -z "$WIFI_IP" ]; then
  warn "The phone isn't on Wi-Fi, so only USB will work for now. Connect it to Wi-Fi and re-run."
else
  "$ADB" -s "$SERIAL" tcpip $ADB_PORT >/dev/null 2>&1
  sleep 3
  timeout 10 "$ADB" -s "$SERIAL" wait-for-device 2>/dev/null
  timeout 5 "$ADB" connect "$WIFI_IP:$ADB_PORT" >/dev/null 2>&1
  if [ "$(timeout 4 "$ADB" -s "$WIFI_IP:$ADB_PORT" shell getprop ro.serialno 2>/dev/null | tr -d '\r')" = "$SERIAL" ]; then
    ok "Wi-Fi debugging on at $WIFI_IP (lasts until the phone restarts)"
  else
    warn "Couldn't connect over Wi-Fi at $WIFI_IP. USB still works."
  fi
fi
save_conf

# ── 3. Phone link: GSConnect (GNOME) or KDE Connect (clipboard, notifications, files)
bold "3. $PC_LINK_NAME"
PKG=org.kde.kdeconnect_tp   # the Android app, for both
app_installed() { pc_adb_shell pm list packages | tr -d '\r' | grep -qx "package:$PKG"; }
link_seen()     { [ -n "$(pc_link_find "$WIFI_IP")" ]; }
link_running()  {
  [ $PC_LINK = kdeconnect ] && return 0
  gdbus call --session --dest $GSC_BUS --object-path /org/gnome/Shell/Extensions/GSConnect \
    --method org.freedesktop.DBus.Peer.Ping >/dev/null 2>&1
}
if ! link_running; then
  warn "GSConnect isn't running. Turn it on in the Extensions app (log out and back in"
  warn "first if it was just installed), then re-run phone-setup."
elif [ -z "$WIFI_IP" ]; then
  warn "$PC_LINK_NAME needs the phone on Wi-Fi — skipping for now."
else
  if ! app_installed; then
    pc_adb_shell am start -a android.intent.action.VIEW -d "market://details?id=$PKG" >/dev/null
    warn "The Play Store is open on the phone — install KDE Connect."
    wait_for 600 "waiting for KDE Connect to be installed" app_installed \
      || warn "Not installed — skipping $PC_LINK_NAME for now."
  fi
fi

if link_running && [ -n "$WIFI_IP" ] && app_installed; then
  pc_adb_shell monkey -p $PKG -c android.intent.category.LAUNCHER 1 >/dev/null 2>&1
  pc_adb_shell appops set $PKG MANAGE_EXTERNAL_STORAGE allow >/dev/null 2>&1 && ok "File access allowed for KDE Connect"

  if ! pc_link_known "$KDEC_ID"; then
    pc_link_discover "$WIFI_IP"
    wait_for 60 "looking for $NAME in $PC_LINK_NAME" link_seen
    KDEC_ID=$(pc_link_find "$WIFI_IP")
  fi

  if [ -z "$KDEC_ID" ]; then
    warn "$PC_LINK_NAME couldn't find the phone. Check both are on the same Wi-Fi, then re-run."
  else
    save_conf
    if pc_link_reachable "$KDEC_ID"; then
      ok "Paired with $PC_LINK_NAME"
    else
      pc_link_pair "$KDEC_ID"
      warn "Accept the pairing request on the phone."
      wait_for 120 "waiting for you to accept" pc_link_reachable "$KDEC_ID" \
        && ok "Paired with $PC_LINK_NAME" || warn "Not paired yet — re-run phone-setup to try again."
    fi
    # Calls are handled by phone-calls; the link's own call alerts would come twice
    if [ $PC_LINK = gsconnect ] && [ -f "$HOME/.config/systemd/user/phone-calls.service" ]; then
      key="$GSC_DCONF/device/$KDEC_ID/disabled-plugins"
      cur=$(dconf read "$key"); cur=${cur#@as }
      if [[ "$cur" != *"'telephony'"* ]]; then
        if [ -z "$cur" ] || [ "$cur" = "[]" ]; then cur="['telephony']"; else cur="${cur%]}, 'telephony']"; fi
        dconf write "$key" "$cur" && ok "Call alerts left to Phone Calls (GSConnect's turned off)"
      fi
    fi
    # Files sidebar bookmark (replaces one for an older path, e.g. from KDE Connect)
    BM="$HOME/.config/gtk-3.0/bookmarks"; mkdir -p "$(dirname "$BM")"; touch "$BM"
    LINE="file://$(python3 -c 'import sys, urllib.parse; print(urllib.parse.quote(sys.argv[1]))' "$(pc_link_storage "$KDEC_ID")") $NAME"
    if ! grep -qxF "$LINE" "$BM"; then
      grep -vxE "file://.*/storage/emulated/0 $(sed 's/[][\\.*^$+?(){}|]/\\&/g' <<< "$NAME")" "$BM" > "$BM.tmp"
      echo "$LINE" >> "$BM.tmp" && mv "$BM.tmp" "$BM"
      ok "Added \"$NAME\" to the Files sidebar"
    fi
  fi
fi

# ── 4. Bluetooth + Extend Unlock (no PIN while near this laptop) ───────────
bold "3b. Audio Share (laptop sound on the phone)"
AS_APK="$HOME/.local/share/audio-share/audio-share-app.apk"
if pc_adb_shell pm list packages | tr -d '\r' | grep -qx "package:io.github.mkckr0.audio_share_app"; then
  ok "Audio Share app installed"
elif [ -f "$AS_APK" ] && "$ADB" -s "$ADB_ID" install -r "$AS_APK" >/dev/null 2>&1; then
  ok "Installed the Audio Share app"
else
  warn "Couldn't install the Audio Share app — Phone Audio won't work on this phone."
fi

bold "4. Bluetooth & Extend Unlock"
bt_paired() { bluetoothctl info "$BT_MAC" 2>/dev/null | grep -q "Paired: yes"; }
if [ -z "$BT_MAC" ]; then
  warn "Couldn't read the phone's Bluetooth address — skipping."
elif bt_paired; then
  ok "Already paired over Bluetooth"
elif ask "Pair over Bluetooth so the phone can stay unlocked near this laptop?"; then
  bluetoothctl power on >/dev/null; bluetoothctl pairable on >/dev/null; bluetoothctl discoverable on >/dev/null
  pc_adb_shell am start -a android.settings.BLUETOOTH_SETTINGS >/dev/null
  warn "On the phone: Pair new device → \"$(bluetoothctl show | sed -n 's/^\s*Alias: //p')\" → confirm the code on both."
  wait_for 180 "waiting for pairing" bt_paired \
    && ok "Paired over Bluetooth" || warn "Not paired — re-run phone-setup to try again."
  bluetoothctl discoverable off >/dev/null
fi
if [ -n "$BT_MAC" ] && bt_paired; then
  bluetoothctl trust "$BT_MAC" >/dev/null
  # Current state (not history): Google's trust agent is managing trust right now
  if pc_adb_shell dumpsys trust 2>/dev/null | grep -A1 "auth.trustagent.GoogleTrustAgent$" | grep -q "managingTrust=1"; then
    ok "Extend Unlock is active"
  elif ask "Set up Extend Unlock (phone stays unlocked while connected to this laptop)?"; then
    pc_adb_shell am start -a android.settings.SECURITY_SETTINGS >/dev/null
    warn "On the phone: More security settings → Extend Unlock (or Smart Lock) → Trusted devices"
    warn "→ Add trusted device → choose this laptop."
    read -rp "  Press Enter when done… "
  fi
fi

save_conf
pc_write_launcher && update-desktop-database "$HOME/.local/share/applications" 2>/dev/null
bold "Done — $NAME is set up."
echo "  App menu → $(pc_display_name "$NAME")   open it on screen"
echo "  phone          open it on screen        phone-cam     use as webcam"
echo "  phone-files    browse its storage       phone-photo   take a photo into a folder"
echo "  phone-unlock   enter the PIN            phone-audio   laptop sound on the phone"
echo "  phone-setup    re-run after the phone restarts"
