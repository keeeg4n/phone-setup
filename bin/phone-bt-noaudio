#!/bin/bash
# Phones stay connected to this laptop over Bluetooth (needed for Extend Unlock), but
# a phone can only connect via its audio profiles, and then Android plays media on
# the laptop. Whenever a set-up phone's audio link appears, drop just the audio
# profiles: the Bluetooth link (and Extend Unlock) stays, audio stays on the phone.
source "$HOME/.local/lib/phone-continuity/common.sh"
AUDIO_UUIDS=(
  0000110a-0000-1000-8000-00805f9b34fb   # A2DP source (phone media → laptop)
)

strip_audio() {
  local c mac uuid
  while read -r c; do
    [ -n "$c" ] || continue
    pc_load "$c"; mac=$BT_MAC
    [ -n "$mac" ] || continue
    if pactl list short cards 2>/dev/null | grep -q "bluez_card.${mac//:/_}"; then
      for uuid in "${AUDIO_UUIDS[@]}"; do
        bluetoothctl disconnect "$mac" "$uuid" >/dev/null 2>&1
      done
    fi
  done <<< "$(pc_confs)"
}

strip_audio
pactl subscribe | while read -r line; do
  case "$line" in
    *"'new' on card"*|*"'change' on card"*) sleep 1; strip_audio ;;
  esac
done
