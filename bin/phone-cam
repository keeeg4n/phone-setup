#!/bin/bash
# Toggle a phone as a webcam ("Phone Camera" at /dev/video10). Run again to stop.
# Usage: phone-cam [--phone NAME] [--front]
source "$HOME/.local/lib/phone-continuity/common.sh"
SINK=/dev/video10
PIDFILE="$XDG_RUNTIME_DIR/phone-cam.pid"

if [ -f "$PIDFILE" ] && kill -0 "$(cat "$PIDFILE")" 2>/dev/null; then
  kill "$(cat "$PIDFILE")"; rm -f "$PIDFILE"
  notify-send -i camera-web "Phone Camera" "Stopped"
  exit 0
fi
if [ ! -e "$SINK" ]; then
  notify-send -i camera-web "Phone Camera" "Virtual webcam driver not loaded ($SINK missing)."
  exit 1
fi

pc_phone_opt "$@"; shift $PC_SHIFT
pc_select "$PHONE_ARG" || exit 1

CAM=(--camera-facing=back)
[ "$1" = "--front" ] && CAM=(--camera-facing=front)

"$SCRCPY" -s "$ADB_ID" --video-source=camera "${CAM[@]}" \
  --camera-size=1920x1080 --camera-fps=30 \
  --no-audio --no-window --no-control \
  --v4l2-sink="$SINK" &
echo $! > "$PIDFILE"
notify-send -i camera-web "Phone Camera" "Using $NAME — pick \"Phone Camera\" in your video app. Run again to stop."
wait
rm -f "$PIDFILE"
