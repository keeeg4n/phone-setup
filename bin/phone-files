#!/bin/bash
# Mount a phone's storage via GSConnect / KDE Connect and open it in Files.
# Usage: phone-files [--phone NAME]
source "$HOME/.local/lib/phone-continuity/common.sh"
pc_phone_opt "$@"; shift $PC_SHIFT
pc_select_link "$PHONE_ARG" || exit 1

DIR=$(pc_link_storage "$KDEC_ID")
pc_link_mount "$KDEC_ID"
for i in $(seq 10); do [ -d "$DIR/DCIM" ] && break; sleep 1; done   # mount can lag a moment
if [ -d "$DIR/DCIM" ]; then
  xdg-open "$DIR"
else
  pc_notify "Couldn't open $NAME's storage. Is KDE Connect allowed to access files on the phone?"
fi
